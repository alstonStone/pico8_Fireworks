pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main--
#include game-manager.lua
#include test.lua
#include firework-builder.lua
#include firework.lua
#include menu.lua
#include menu-items.lua
#include firework-transition.lua


function _init()
	
  change_state("menu")
  if state=="test" then
    test_init()
  end
  menu_init()
end

function _update()
  current_state.update()
end

function _draw()
  current_state.draw()
  --print(state)
end



