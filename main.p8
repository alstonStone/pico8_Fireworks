version 43
__lua__
--main--
#include game-manager.lua
#include test.lua
#include menu.lua
#include menu-items.lua

function _init()
	
  change_state("build")
  if state=="test" then
    test_init()
  end
  menu_init()
end

function _update()
  current_state.update()
end

function _draw()
  current_state.draw()
  --print(state)
end



